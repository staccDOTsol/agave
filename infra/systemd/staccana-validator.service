[Unit]
Description=Staccana validator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=staccana
Group=staccana
LimitNOFILE=2000000
LimitNPROC=65535
TimeoutStopSec=180
Restart=on-failure
RestartSec=10s

# Adjust these env paths per box
Environment="RUST_LOG=solana=info,solana_metrics=warn"
Environment="SOLANA_METRICS_CONFIG=host=https://metrics.example,db=staccana,u=writer,p=changeme"

# BANK_HASH (and GENESIS_HASH) are populated by step 30. The leading `-` makes
# systemd tolerate the file being missing on first run (validator will then refuse
# to start, which is the correct behavior — you must run step 30 first).
EnvironmentFile=-/etc/staccana/bank-hash

ExecStart=/usr/local/bin/agave-validator \
  --identity /etc/staccana/keys/identity.json \
  --vote-account /etc/staccana/keys/vote.json \
  --ledger /var/lib/staccana/ledger \
  --accounts /var/lib/staccana/accounts \
  --snapshot-interval-slots 100 \
  --maximum-local-snapshot-age 500 \
  --limit-ledger-size 200000000 \
  --no-poh-speed-test \
  --no-os-network-limits-test \
  --no-wait-for-vote-to-start-leader \
  --wait-for-supermajority 1 \
  --expected-bank-hash ${BANK_HASH} \
  --expected-shred-version ${SHRED_VERSION} \
  --full-rpc-api \
  --allow-private-addr \
  --rpc-port 8899 \
  --rpc-bind-address 127.0.0.1 \
  --gossip-port 8001 \
  --dynamic-port-range 8002-8020 \
  --log /var/log/staccana/validator.log

# --no-wait-for-vote-to-start-leader: bypasses the cold-start interlock that prevents
#   a fresh validator from producing its first leader slot until it has landed a vote.
# --wait-for-supermajority 0 + --expected-bank-hash $BANK_HASH: the OTHER half of the
#   single-validator bootstrap recipe (this is what jito-solana's `bootstrap` script
#   and agave's `multinode-demo/bootstrap-validator.sh` use). At slot 0 the validator
#   waits for supermajority of stake to be visible on gossip; for a single-node
#   cluster with 100% stake that's instantly true, AND the wait-for-supermajority
#   path bypasses the tower-BFT threshold check that otherwise rejects every vote
#   (FailedThreshold(_, _, 0, total_stake) — "0 stake voted on the threshold-required
#   ancestor"). Without this combo, slot advances but no votes ever land and no slot
#   ever roots. The bank hash comes from $BANK_HASH (sourced from
#   /etc/staccana/bank-hash, written by step 30 via `agave-ledger-tool bank-hash`).
# --full-rpc-api: enables the full set of RPC methods (getBlock with rewards,
#   getStakes, etc) that the explorer + bridge UIs need.
# --allow-private-addr: permits gossip with peers on RFC1918 private addresses, which
#   is what we'll use when val-eu / val-apac join over wireguard or a private VPC.

[Install]
WantedBy=multi-user.target

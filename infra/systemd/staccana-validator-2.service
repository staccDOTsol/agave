[Unit]
Description=Staccana validator (peer #2 — bootstrap pair with validator-1)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=staccana
Group=staccana
LimitNOFILE=2000000
LimitNPROC=65535
TimeoutStopSec=180
Restart=on-failure
RestartSec=10s

Environment="RUST_LOG=solana=info,solana_metrics=warn"
Environment="SOLANA_METRICS_CONFIG=host=https://metrics.example,db=staccana,u=writer,p=changeme"

# --gossip-host: validator-2's PUBLIC IP. Required when --entrypoint is set so
# the validator can start before the entrypoint is reachable (bootstrap chicken-
# and-egg). Without this, the validator exits with "Unable to determine the
# validator's public IP address" and systemd restart-loops.
Environment="STACCANA_THIS_PUBLIC_IP=84.32.220.76"
# Address of validator-1's gossip endpoint. Default 84.32.220.211:8001 = the
# val-bootstrap (cunning-raptor) Cherryservers box.
Environment="STACCANA_VAL1_GOSSIP=84.32.220.211:8001"

ExecStart=/usr/local/bin/agave-validator \
  --identity /etc/staccana/keys-2/identity.json \
  --vote-account /etc/staccana/keys-2/vote.json \
  --ledger /var/lib/staccana/ledger \
  --accounts /var/lib/staccana/accounts \
  --snapshot-interval-slots 100 \
  --maximum-local-snapshot-age 500 \
  --limit-ledger-size 200000000 \
  --no-poh-speed-test \
  --no-os-network-limits-test \
  --no-port-check \
  --no-wait-for-vote-to-start-leader \
  --gossip-host ${STACCANA_THIS_PUBLIC_IP} \
  --entrypoint ${STACCANA_VAL1_GOSSIP} \
  --full-rpc-api \
  --allow-private-addr \
  --rpc-port 8899 \
  --rpc-bind-address 127.0.0.1 \
  --gossip-port 8001 \
  --dynamic-port-range 8002-8020 \
  --log /var/log/staccana/validator-2.log

# --rpc-bind-address 127.0.0.1: same reason as validator-1's unit — Cherryservers
# blocks 8899/8900 inter-host, the validator's ip_echo_server reachability check
# fails when binding to 0.0.0.0, and the validator restart-loops. Localhost
# binding skips the check.

# Sister of staccana-validator.service. The two validators are baked into genesis
# together (step 30 generates BOTH key triplets and passes both to genesis-bake
# via --identity-keypair + --additional-validator). Each one runs on its own box,
# pointing at the other via --entrypoint. They gossip, observe each other's votes,
# and converge — which is what breaks the agave 2.0.x tower-BFT solo-validator
# deadlock that --wait-for-supermajority cannot escape.
#
# DEPLOYMENT NOTE: this unit lives on validator-2's box (e.g. hip-jawfish at
# 84.32.220.76) and reads keys from /etc/staccana/keys-2/. The keys-2 directory
# is generated by step 30 on validator-1's box and rsync'd over (along with the
# baked ledger) before this service starts.

[Install]
WantedBy=multi-user.target
